  "source": {
    "language": "javascript",
    "entrypoint": "createPost",
    "code": "export function createPost(api) {\n  api.getProperty('coordinatePrecision');\n  const offsetIndex = api.getProperty('offsetIndex');\n  let programStarted = false;\n  let operationOpen = false;\n  let passOpen = false;\n  let compensation = 'off';\n  let compensationEnded = false;\n  let operationCompensated = false;\n\n  function requireState(condition, message) {\n    if (!condition) throw new Error(message);\n  }\n\n  function emitArc(event) {\n    const command = event.clockwise ? 'motion.arc-clockwise' : 'motion.arc-counterclockwise';\n    if (event.fullCircle) {\n      api.emitMotion(command, {\n        x: 2 * event.center.x - event.start.x,\n        y: 2 * event.center.y - event.start.y,\n        i: event.center.x,\n        j: event.center.y\n      });\n    }\n    api.emitMotion(command, {\n      x: event.end.x,\n      y: event.end.y,\n      i: event.center.x,\n      j: event.center.y\n    });\n  }\n\n  return {\n    onEvent(event) {\n      if (event.kind === 'program-start') {\n        requireState(!programStarted, 'Program start was received more than once.');\n        api.emitCommand('origin.wire-position', {\n          x: event.initialWirePosition.x,\n          y: event.initialWirePosition.y\n        });\n        api.emitCommand('setup.g60', {});\n        api.emitCommand('setup.g38', {});\n        api.emitCommand('distance.absolute', {});\n        programStarted = true;\n        return;\n      }\n      if (event.kind === 'operation-start') {\n        requireState(programStarted && !operationOpen, 'Operation start is out of order.');\n        api.emitCommand('compensation.finish', {});\n        api.emitCommand('compensation.cancel', {});\n        compensation = 'off';\n        compensationEnded = false;\n        operationCompensated = false;\n        operationOpen = true;\n        return;\n      }\n      if (event.kind === 'pass-start') {\n        requireState(operationOpen && !passOpen, 'Pass start is out of order.');\n        passOpen = true;\n        return api.consume('Single-cut pass started.');\n      }\n      if (event.kind === 'wire-continue') {\n        requireState(operationOpen && compensation === 'off', 'Wire continuation requires compensation off.');\n        return api.consume('Wire remains threaded.');\n      }\n      if (event.kind === 'wire-separate') {\n        requireState(operationOpen && compensation === 'off', 'Wire separation requires compensation off.');\n        requireState(event.method === 'manual', 'Automatic wire separation has no evidenced command.');\n        return api.emitCommand('operator.manual-wire-separate', {});\n      }\n      if (event.kind === 'position') {\n        requireState(operationOpen && compensation === 'off', 'Positioning requires compensation off.');\n        return api.emitMotion('motion.rapid', { x: event.to.x, y: event.to.y });\n      }\n      if (event.kind === 'wire-thread') {\n        requireState(operationOpen && compensation === 'off', 'Wire threading requires compensation off.');\n        requireState(event.method === 'manual', 'Automatic wire threading has no evidenced command.');\n        return api.emitCommand('operator.manual-wire-thread', {});\n      }\n      if (event.kind === 'compensation-start') {\n        requireState(passOpen && compensation === 'off' && !operationCompensated, 'Compensation start is out of order.');\n        api.emitCommand(\n          event.wireSide === 'left' ? 'compensation.left' : 'compensation.right',\n          { offset: offsetIndex }\n        );\n        compensation = event.wireSide;\n        operationCompensated = true;\n        return;\n      }\n      if (event.kind === 'motion') {\n        requireState(passOpen && compensation !== 'off' && !compensationEnded, 'Cutting motion requires active compensation.');\n        if (event.motion === 'linear') {\n          return api.emitMotion('motion.linear', { x: event.end.x, y: event.end.y });\n        }\n        return emitArc(event);\n      }\n      if (event.kind === 'program-stop') {\n        requireState(operationOpen, 'Program stop requires an open operation.');\n        return api.emitCommand('operator.program-stop', {});\n      }\n      if (event.kind === 'compensation-end') {\n        requireState(operationCompensated && compensation !== 'off' && !compensationEnded, 'Compensation end is out of order.');\n        compensationEnded = true;\n        return api.consume('Cancellation is deferred to the next operation boundary or program end.');\n      }\n      if (event.kind === 'pass-end') {\n        requireState(passOpen && operationCompensated && compensationEnded, 'Pass end requires completed compensated cutting.');\n        passOpen = false;\n        return api.consume('Single-cut pass ended.');\n      }\n      if (event.kind === 'operation-end') {\n        requireState(operationOpen && !passOpen && operationCompensated && compensationEnded, 'Operation end is out of order.');\n        operationOpen = false;\n        return api.consume('Operation completed; compensation cancellation remains pending.');\n      }\n      if (event.kind === 'program-end') {\n        requireState(programStarted && !operationOpen, 'Program end requires all operations to be complete.');\n        api.emitCommand('compensation.finish', {});\n        api.emitCommand('compensation.cancel', {});\n        api.emitCommand('program.end', {});\n        compensation = 'off';\n        programStarted = false;\n        return;\n      }\n      throw new Error('Unsupported execution event: ' + event.kind);\n    }\n  };\n}"
  },
