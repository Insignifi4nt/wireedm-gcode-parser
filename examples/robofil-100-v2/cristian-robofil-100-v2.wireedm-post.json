  "source": {
    "language": "javascript",
    "entrypoint": "createPost",
    "code": "export function createPost(api) {\n  api.getProperty('coordinatePrecision');\n  const offsetIndex = api.getProperty('offsetIndex');\n  let programStarted = false;\n  let operationOpen = false;\n  let passOpen = false;\n  let compensation = 'off';\n  let compensationEnded = false;\n  let operationCompensated = false;\n  let continuationPending = false;\n  let rethreadPending = false;\n\n  function requireState(condition, message) {\n    if (!condition) throw new Error(message);\n  }\n\n  function cancelCompensation() {\n    api.emitCommand('compensation.cancel', {});\n    api.emitCommand('compensation.finish', {});\n    compensation = 'off';\n  }\n\n  function emitArc(event) {\n    const command = event.clockwise ? 'motion.arc-clockwise' : 'motion.arc-counterclockwise';\n    if (event.fullCircle) {\n      api.emitMotion(command, {\n        x: 2 * event.center.x - event.start.x,\n        y: 2 * event.center.y - event.start.y,\n        i: event.center.x,\n        j: event.center.y\n      });\n    }\n    api.emitMotion(command, {\n      x: event.end.x,\n      y: event.end.y,\n      i: event.center.x,\n      j: event.center.y\n    });\n  }\n\n  return {\n    onEvent(event) {\n      if (event.kind === 'program-start') {\n        requireState(!programStarted, 'Program start was received more than once.');\n        api.emitCommand('origin.wire-position', {\n          x: event.initialWirePosition.x,\n          y: event.initialWirePosition.y\n        });\n        programStarted = true;\n        return;\n      }\n      if (event.kind === 'operation-start') {\n        requireState(programStarted && !operationOpen, 'Operation start is out of order.');\n        compensationEnded = false;\n        operationCompensated = false;\n        continuationPending = false;\n        rethreadPending = false;\n        operationOpen = true;\n        return api.consume('Operation started.');\n      }\n      if (event.kind === 'pass-start') {\n        requireState(operationOpen && !passOpen, 'Pass start is out of order.');\n        passOpen = true;\n        return api.consume('Single-cut pass started.');\n      }\n      if (event.kind === 'wire-continue') {\n        requireState(operationOpen && compensation !== 'off', 'Wire continuation requires active compensation from the preceding contour.');\n        continuationPending = true;\n        return api.consume('Wire and compensation remain active for clear rapid positioning.');\n      }\n      if (event.kind === 'wire-separate') {\n        throw new Error('Wire separation is not verified for this Robofil 100 package.');\n      }\n      if (event.kind === 'position') {\n        requireState(operationOpen && (compensation === 'off' || continuationPending || event.separatesWire), 'Positioning with active compensation requires a continuous or separating transition.');\n        if (event.separatesWire) {\n          requireState(compensation !== 'off' && !continuationPending, 'A separating rapid requires completed compensated cutting.');\n          return api.emitMotion('motion.rapid-separating', { x: event.to.x, y: event.to.y });\n        }\n        return api.emitMotion('motion.rapid', { x: event.to.x, y: event.to.y });\n      }\n      if (event.kind === 'wire-thread') {\n        requireState(event.method === 'manual' && compensation !== 'off', 'Only manual rethreading after a completed contour is supported.');\n        rethreadPending = true;\n        return api.emitCommand('operator.manual-thread', {});\n      }\n      if (event.kind === 'compensation-start') {\n        requireState(passOpen && !operationCompensated, 'Compensation start is out of order.');\n        if (compensation !== 'off') {\n          requireState(continuationPending || rethreadPending, 'Active compensation requires a reviewed transition.');\n          continuationPending = false;\n          rethreadPending = false;\n          operationCompensated = true;\n          if (compensation === event.wireSide) {\n            return api.consume('Compensation side remains active from the preceding contour.');\n          }\n          api.emitCommand(event.wireSide === 'left' ? 'compensation.left' : 'compensation.right', {});\n          api.emitCommand('setup.g38', { offset: offsetIndex });\n          compensation = event.wireSide;\n          return;\n        }\n        api.emitCommand(event.wireSide === 'left' ? 'compensation.left' : 'compensation.right', {});\n        api.emitCommand('setup.g38', { offset: offsetIndex });\n        compensation = event.wireSide;\n        operationCompensated = true;\n        return;\n      }\n      if (event.kind === 'motion') {\n        requireState(passOpen && compensation !== 'off' && !compensationEnded, 'Cutting motion requires active compensation.');\n        if (event.motion === 'linear') {\n          return api.emitMotion('motion.linear', { x: event.end.x, y: event.end.y });\n        }\n        return emitArc(event);\n      }\n      if (event.kind === 'program-stop') {\n        requireState(operationOpen, 'Program stop requires an open operation.');\n        return api.emitCommand('operator.program-stop', {});\n      }\n      if (event.kind === 'compensation-end') {\n        requireState(operationCompensated && compensation !== 'off' && !compensationEnded, 'Compensation end is out of order.');\n        compensationEnded = true;\n        return api.consume('Compensation cancellation is deferred until program end.');\n      }\n      if (event.kind === 'pass-end') {\n        requireState(passOpen && operationCompensated && compensationEnded, 'Pass end requires completed compensated cutting.');\n        passOpen = false;\n        return api.consume('Single-cut pass ended.');\n      }\n      if (event.kind === 'operation-end') {\n        requireState(operationOpen && !passOpen && operationCompensated && compensationEnded, 'Operation end is out of order.');\n        operationOpen = false;\n        return api.consume('Operation completed with compensation state retained pending the next transition.');\n      }\n      if (event.kind === 'program-end') {\n        requireState(programStarted && !operationOpen && compensation !== 'off', 'Program end requires completed compensated operations.');\n        cancelCompensation();\n        api.emitCommand('program.end', {});\n        programStarted = false;\n        return;\n      }\n      throw new Error('Unsupported execution event: ' + event.kind);\n    }\n  };\n}"
  },
