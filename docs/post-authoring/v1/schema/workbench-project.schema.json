          "type": "string"
        },
        "schemaVersion": {
          "const": 2,
          "type": "number"
        },
        "id": {
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
