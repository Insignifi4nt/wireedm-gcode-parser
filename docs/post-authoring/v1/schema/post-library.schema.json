{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wire-edm.local/schemas/wire-edm-post-library-v1.json",
  "$comment": "Generated from src/domain/post-processor/postLibraryStorage.ts by npm run post:docs:generate.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "installations"
  ],
  "properties": {
    "format": {
      "const": "wire-edm-post-library",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "installations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "package"
        ],
        "properties": {
          "ref": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "packageId",
              "version",
              "contentHash"
            ],
            "properties": {
              "packageId": {
                "minLength": 1,
                "maxLength": 80,
                "type": "string"
              },
              "version": {
                "minLength": 5,
                "maxLength": 80,
                "type": "string"
              },
              "contentHash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            }
          },
          "package": {
            "description": "A wire-edm-post package validated against post-package.schema.json."
          }
        }
      }
    }
  }
}
