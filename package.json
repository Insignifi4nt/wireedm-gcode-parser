{
  "name": "wire-edm-workbench",
  "homepage": "https://insignifi4nt.github.io/wireedm-gcode-parser",
  "version": "0.0.698",
  "description": "A local-first Wire EDM workbench with controller-neutral CAM state and complete installable machine packages.",
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check && node scripts/audit-icon-current-integration.mjs --check && npm run icons:geometry && vitest --run src/components/icons",
    "icons:geometry": "node scripts/icon-revisions/check-cam-v3-geometry.mjs --check",
    "icons:audit": "node scripts/audit-icon-current-integration.mjs && node scripts/reconcile-icon-inventory.mjs --inventory docs/design/inventory/source-icon-inventory.audit.json --markdown docs/design/inventory/source-icon-inventory.md",
    "icons:review": "node scripts/render-icon-review.mjs && node scripts/audit-icon-review-coverage.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:workbench": "playwright test e2e/editor-existing-project.spec.ts",
    "upid:validate": "tsx --tsconfig tsconfig.app.json scripts/upid.ts",
    "upid:benchmark": "tsx --tsconfig tsconfig.app.json scripts/benchmark-upid.ts",
    "upid:conformance": "tsx --tsconfig tsconfig.app.json scripts/upid.ts docs/upid/v1/examples/mixed-primitives.upid.json docs/upid/v1/examples/partial-circle-stop.upid.json docs/upid/v1/examples/compensated-circle.upid.json --require-executable",
    "post:docs:generate": "tsx scripts/generate-post-authoring-docs.ts",
    "post:docs:check": "tsx scripts/generate-post-authoring-docs.ts --check",
    "post:conformance": "tsx scripts/run-post-conformance.ts",
    "machine-package:build": "tsx scripts/machine-package.ts build",
    "machine-package:validate-source": "tsx scripts/machine-package.ts validate-source",
    "machine-package:validate": "tsx scripts/machine-package.ts validate",
    "machine-package:inspect": "tsx scripts/machine-package.ts inspect",
    "pw:open": "playwright-cli open http://127.0.0.1:3777/wireedm-gcode-parser/ --headed && playwright-cli resize 1920 1200",
    "pw:seed": "node scripts/seed-playwright-workbench.mjs",
    "pw:seed:reload": "node scripts/seed-playwright-workbench.mjs --reload",
    "postbuild": "npm run docs:build && npm run docs:check && npm run third-party:bundle",
    "third-party:bundle": "tsx scripts/distribute-step-sources.ts && tsx scripts/distribute-cad-sources.ts",
    "third-party:check": "tsx scripts/distribute-step-sources.ts --check && tsx scripts/distribute-cad-sources.ts --check",
    "docs:build": "node scripts/build-documentation.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "release:check": "node scripts/check-release.mjs",
    "post:hash": "tsx scripts/hash-post.ts"
  },
  "keywords": [
    "wire-edm",
    "dxf",
    "gcode",
    "cnc",
    "cam",
    "local-first"
  ],
  "author": "Wire EDM Development Team",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@sinclair/typebox": "^0.34.52",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "occt-import-js": "0.0.23",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "file:vendor/cad-kernel/replicad-opencascadejs-1.1.0-wireedm.2.tgz",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.17",
    "three": "0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "16.0.0",
    "marked": "18.0.13",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  }
}
