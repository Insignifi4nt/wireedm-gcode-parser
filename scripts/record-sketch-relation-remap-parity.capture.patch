diff --git a/src/domain/cad/cadSketchRemapParityCapture.ts b/src/domain/cad/cadSketchRemapParityCapture.ts
new file mode 100644
index 00000000..ad872fb1
--- /dev/null
+++ b/src/domain/cad/cadSketchRemapParityCapture.ts
@@ -0,0 +1,42 @@
+// Relation remap parity capture: with WIREEDM_CAPTURE_REMAP_PARITY naming a directory, each call of a geometry-changing sketch operation
+// is appended to a JSON Lines file there for each process and thread, with what the operation gave: its result's relations, or its
+// error. Inputs with more than 300 relations, or that are not plain data, are skipped.
+type Proc = { env?: Record<string, string | undefined>; pid?: number; getBuiltinModule?: (name: string) => any };
+const seen = new Set<string>();
+function describe(error: unknown) {
+  if (!(error instanceof Error)) return { thrown: String(error) };
+  const e = error as Error & { code?: string; relationIds?: readonly string[]; pointIds?: readonly string[] };
+  return { code: e.code ?? e.name, message: e.message, ...(e.relationIds ? { relationIds: [...e.relationIds] } : {}), ...(e.pointIds ? { pointIds: [...e.pointIds] } : {}) };
+}
+const graphOf = (graph: any) => graph ? { relations: graph.relations, points: graph.points.map((point: { id: string }) => point.id) } : null;
+function summarize(operation: string, result: any): unknown {
+  switch (operation) {
+    case 'trim-prepare': case 'extend-prepare': return { target: result.target };
+    case 'trim': case 'extend': case 'split': return graphOf(result.graph);
+    case 'pattern-reconcile': return graphOf(result);
+    default: return { graph: graphOf(result.sketch?.graph) };
+  }
+}
+function relationCount(args: any): number {
+  const graph = args?.graph ?? args?.sketch?.graph;
+  return graph?.relations?.length ?? 0;
+}
+export function captureCadSketchRemapParity<A, R>(operation: string, run: (args: A) => R): (args: A) => R {
+  return (args: A) => {
+    const proc = (globalThis as { process?: Proc }).process, directory = proc?.env?.WIREEDM_CAPTURE_REMAP_PARITY;
+    if (!directory || !proc?.getBuiltinModule || relationCount(args) > 300) return run(args);
+    let input: string;
+    try { input = JSON.stringify(args); } catch { return run(args); }
+    const fs = proc.getBuiltinModule('node:fs'), crypto = proc.getBuiltinModule('node:crypto'), threads = proc.getBuiltinModule('node:worker_threads');
+    const hash = crypto.createHash('sha256').update(operation + '\n' + input).digest('hex');
+    const write = (outcome: unknown) => {
+      if (seen.has(hash)) return;
+      seen.add(hash);
+      fs.appendFileSync(directory + '/remap-' + proc.pid + '-' + threads.threadId + '.jsonl', JSON.stringify({ hash, operation, input: JSON.parse(input), outcome }) + '\n');
+    };
+    let result: R;
+    try { result = run(args); } catch (error) { write({ error: describe(error) }); throw error; }
+    write({ ok: summarize(operation, result) });
+    return result;
+  };
+}
